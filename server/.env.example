# ── Server ──
PORT=3001
NODE_ENV=development

# ── Database ──
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/civicpulse
# ── JWT ──
# Use a unique random secret of at least 32 characters in production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── CORS ──
# Set this to the exact frontend origin in production (no path, no wildcard).
CORS_ORIGIN=http://localhost:5173

# ── Email (reserved for the planned Phase 3 email workflow; no mailer is mounted yet) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@civicpulse.local

# ── Platform Admin Bootstrap ──
ADMIN_EMAIL=admin@civicpulse.local
# Replace with a strong password before running the seed script in production.
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# ── Uploads ──
UPLOADS_DIR=./uploads
