# ── Server ──
PORT=3001
NODE_ENV=development

# ── Database ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/SamajX

# ── JWT ──
# Use a unique random secret of at least 32 characters in production.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── CORS ──
# Set this to the exact frontend origin in production (no path, no wildcard).
CORS_ORIGIN=http://localhost:5173

# ── Email (reserved for the planned Phase 3 email workflow; no mailer is mounted yet) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@SamajX.local

# ── Platform Admin Bootstrap ──
ADMIN_EMAIL=admin@SamajX.local
# Replace with a strong password before running the seed script in production.
ADMIN_PASSWORD=admin123

# ── Uploads ──
UPLOADS_DIR=./uploads

# ── AI Layer (Phase 6) ──
AI_ENABLED=true
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-3-haiku-20240307
AI_TIMEOUT_MS=20000

